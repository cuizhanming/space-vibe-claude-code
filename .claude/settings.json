      "Bash(flutter build:*)",
      "Bash(flutter pub:*)",
      "Bash(flutter analyze:*)",
      "Bash(python -m http.server:*)",
      "Bash(npx serve:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git push:*)",
      "Bash(cat:*)",
