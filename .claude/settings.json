      "Bash(npm run lint:*)",
      "Bash(npm run start:*)",
      "Bash(mvn spring-boot:run:*)",
      "Bash(mvn test:*)",
      "Bash(mvn clean:*)",
      "Bash(mvn verify:*)",
      "Bash(mvn compile:*)",
